EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat public SDK key for iOS/Android (safe to ship client-side, same
# as the Supabase key above) — from your RevenueCat project → API keys.
# See REVENUECAT_SETUP.md.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat Web Billing public API key — a *different* key from the one
# above, from your RevenueCat project → API keys → the "Web Billing" app.
# Requires a Stripe account connected in the RevenueCat dashboard. See
# REVENUECAT_SETUP.md.
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_xxxxxxxxxxxxxxxxxxxxxxxx
# Spotify Client ID from your app at developer.spotify.com/dashboard — not
# secret (Authorization Code + PKCE needs no client secret at all). Also
# set the same value as a Supabase secret: SPOTIFY_CLIENT_ID (see
# supabase/functions/spotify-sync/index.ts). Register both redirect URIs
# in Spotify's dashboard: justonemoredance://spotify-callback (native) and
# your web app's own root URL, e.g. https://justonemoredance.com/ (web —
# see src/lib/spotifyAuth.ts for why it's the root, not a dedicated route).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sentry DSN, native only (see src/lib/errorReporting.ts — guarded so it
# never bundles into the web build). From sentry.io → your project →
# Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
# Google OAuth Client IDs for YouTube playlist sync (see
# src/lib/googleAuth.ts) — not secret, same PKCE-no-secret reasoning as
# Spotify's client id. Google requires TWO separate OAuth clients from
# Google Cloud Console → APIs & Services → Credentials, with the YouTube
# Data API v3 enabled first:
#  - NATIVE: an "iOS" type client, bundle id com.justonemoredance.app,
#    redirect URI com.justonemoredance.app:/oauth2redirect (this exact
#    reverse-DNS custom scheme — also registered as a second app.json
#    `scheme` entry, see app.json).
#  - WEB: a "Web application" type client, authorized redirect URI
#    https://justonemoredance.com/?provider=youtube
# Also set matching Supabase secrets (see
# supabase/functions/youtube-sync/index.ts for the full list, including
# the two client SECRETS — those are never client-side/EXPO_PUBLIC_):
#   supabase secrets set GOOGLE_CLIENT_ID_NATIVE=... GOOGLE_CLIENT_SECRET_NATIVE=
#   supabase secrets set GOOGLE_CLIENT_ID_WEB=... GOOGLE_CLIENT_SECRET_WEB=...
EXPO_PUBLIC_GOOGLE_CLIENT_ID_NATIVE=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
