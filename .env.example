EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat public SDK key for iOS/Android (safe to ship client-side, same
# as the Supabase key above) — from your RevenueCat project → API keys.
# See REVENUECAT_SETUP.md.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat Web Billing public API key — a *different* key from the one
# above, from your RevenueCat project → API keys → the "Web Billing" app.
# Requires a Stripe account connected in the RevenueCat dashboard. See
# REVENUECAT_SETUP.md.
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_xxxxxxxxxxxxxxxxxxxxxxxx
